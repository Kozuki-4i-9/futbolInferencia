# 1. Clonar un repositorio
git clone https://github.com/usuario/repo.git

# 2. Inicializar un repositorio local
git init

# 3. Ver estado de los archivos
git status

# 4. Agregar archivos al área de staging
git add .
# o archivo específico
git add archivo.py

# 5. Hacer un commit con mensaje
git commit -m "Descripción del cambio"

# 6. Ver historial de commits
git log --oneline

# 7. Conectar con un repositorio remoto
git remote add origin https://github.com/usuario/repo.git

# 8. Subir cambios a la rama principal (main/master)
git push -u origin main

# 9. Traer cambios del repositorio remoto
git pull origin main

# 10. Obtener información del remoto sin fusionar
git fetch origin

# 11. Ver diferencias entre commits o archivos
git diff

# 12. Crear una nueva rama
git branch nueva-rama

# 13. Cambiar a una rama
git checkout nueva-rama
# o (más moderno)
git switch nueva-rama

# 14. Fusionar una rama con la actual
git merge nueva-rama

# 15. Clonar solo una rama específica
git clone --branch rama-especifica https://github.com/usuario/repo.git