# 1. Construir la imagen desde un Dockerfile
docker build -t mi-django-app .

# 2. Levantar servicios definidos en docker-compose.yml
docker-compose up -d

# 3. Ver contenedores en ejecución
docker ps

# 4. Ver todos los contenedores (incluidos los detenidos)
docker ps -a

# 5. Detener un contenedor
docker stop <nombre_o_id>

# 6. Eliminar un contenedor
docker rm <nombre_o_id>

# 7. Ver imágenes descargadas/localmente
docker images

# 8. Eliminar una imagen
docker rmi <nombre_o_id>

# 9. Ver logs de un contenedor
docker logs <nombre_o_id>

# 10. Entrar a la terminal de un contenedor en ejecución
docker exec -it <nombre_o_id> bash

# 11. Ejecutar migraciones de Django dentro del contenedor
docker exec -it <nombre_o_id> python manage.py migrate

# 12. Crear un superusuario en Django
docker exec -it <nombre_o_id> python manage.py createsuperuser

# 13. Reiniciar un servicio con docker-compose
docker-compose restart

# 14. Detener y eliminar todos los contenedores, redes y volúmenes definidos en compose
docker-compose down -v

